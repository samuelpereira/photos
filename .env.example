APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PHOTO_STORAGE_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
# S3: PHOTO_STORAGE_DISK=s3

VITE_APP_NAME="${APP_NAME}"

PHOTO_DISPLAY_MAX_WIDTH=2400
PHOTO_THUMBNAIL_MAX_WIDTH=1200
PHOTO_THUMBNAIL_QUALITY=82
PHOTO_WATERMARK_TEXT="photographer name"
PHOTO_WATERMARK_LOWERCASE=true

SITE_CONTACT_NAME=
SITE_CONTACT_TAGLINE=
SITE_CONTACT_EMAIL=
SITE_CONTACT_PHONE=
SITE_CONTACT_LOCATION=
SITE_CONTACT_INSTAGRAM=
SITE_CONTACT_FACEBOOK=

USER_NAME=''
USER_EMAIL=''
USER_PASSWORD=''
